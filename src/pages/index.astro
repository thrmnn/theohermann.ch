---
import BaseLayout from '../layouts/BaseLayout.astro';
import StataPlan from '../components/StataPlan.astro';
import { author } from '../data/author';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// Static text (not in a sidecar), with its source in the demo at
// github.com/thrmnn/ros2-localization-triage:
//   recovery_alpha 0.0, the two ros2 param lines, "no built-in way to recover its position"   docs/finding-amcl-recovery.md
//   ROS 1 and ROS 2, Nav2 and AMCL; analysis runs on your side or under NDA                  README.md
//   carried to a floor missing from its map; the ceiling markers (AprilTags)                  docs/finding-confidently-wrong.md
// The two headline numbers and the seconds lost render from public/data/stata-replay.meta.json
// (lost_window medians, zones_s), written by scripts/sample-stata-replay.py from the demo's
// results/stata/. The floor plan renders from public/data/stata-plan.json.
const REPO = 'https://github.com/thrmnn/ros2-localization-triage';
const ACCOUNT = `${REPO}/blob/main/docs/finding-confidently-wrong.md`;
const mailto = `mailto:${author.email}?subject=${encodeURIComponent('One incident')}`;

const readJson = (f: string) => JSON.parse(readFileSync(join(process.cwd(), 'public/data', f), 'utf8'));
const meta = readJson('stata-replay.meta.json') as {
  lost_window: { amcl_reported_sigma_median_m: number; position_error_median_m: number };
  zones_s: { lost_start_s: number; lost_end_s: number };
};
const sigma = Math.round(meta.lost_window.amcl_reported_sigma_median_m * 100);
const error = Math.round(meta.lost_window.position_error_median_m);
const lostS = Math.round(meta.zones_s.lost_end_s - meta.zones_s.lost_start_s);
---

<BaseLayout ogType="profile">
  <main class="page">
    <header class="hero">
      <p class="who">Théo Hermann · independent robotics practitioner · MSc Robotics, EPFL</p>
      <h1>A robot reported its position to within {sigma} cm. It was {error} m away.</h1>
      <div class="hero-plan">
        <StataPlan />
      </div>
      <div class="hero-side">
        <p class="note">A PR2 robot in MIT's Stata Center, from a public recording, after an elevator trip to a floor missing from its map. Medians over the {lostS} seconds it was lost, checked against markers on the ceiling.</p>
        <div class="offer">
          <p><strong>When a robot fails and the logs don't say why, I show what happened, when, and how far off, with the evidence.</strong></p>
          <p>Send me one recording. You get a written account: what happened, what the evidence supports, and what it does not.</p>
          <p>ROS 1 and ROS 2, Nav2 and AMCL. Analysis runs on your side or under NDA.</p>
        </div>
        <p class="ask" id="contact">
          <a class="btn" href={author.cal} rel="noopener">Book a 30-minute call</a>
          <a href={mailto}>or send me one incident</a>
        </p>
      </div>
    </header>

    <section>
      <h2>If you run Nav2, check this in one minute</h2>
      <p>Stock Nav2 ships AMCL, the part that works out where the robot is, with both recovery terms at 0.0: a robot that gets moved or lost has no automatic way to recover its position, unless you change them.</p>
      <pre><code>ros2 param get /amcl recovery_alpha_slow
ros2 param get /amcl recovery_alpha_fast</code></pre>
      <p class="note"><a href={`${REPO}/blob/main/docs/finding-amcl-recovery.md`}>Source</a> · <a href="https://github.com/ros-navigation/navigation2/blob/jazzy/nav2_bringup/params/nav2_params.yaml">Nav2 defaults</a></p>
    </section>

    <p class="account"><a href={ACCOUNT} rel="noopener">The full written account of this example</a></p>
  </main>

  <footer class="foot">
    <p>Sources: <a href={REPO}>github.com/thrmnn/ros2-localization-triage</a>; MIT Stata Center dataset (CC BY 3.0). Who I am: <a href="https://theoalessandro.com">theoalessandro.com</a></p>
  </footer>
</BaseLayout>

<style>
  .page, .foot { max-width: 38rem; margin: 0 auto; padding: 0 20px; }
  .page { padding-top: 20px; color: var(--text-primary); font-size: 18px; line-height: 1.55; }
  .who { font-size: 15px; color: var(--text-secondary); }
  h1 { font-size: clamp(27px, 5.6vw, 40px); line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; margin: 12px 0 4px; }
  .hero-plan { margin-top: 8px; }
  .offer { margin-top: 16px; }
  .offer > * + * { margin-top: 10px; }
  .ask { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin: 16px 0 0; }
  .btn {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px;
    background: var(--text-primary); color: var(--bg-primary); border: 2px solid var(--text-primary);
    border-radius: 0; font-weight: 700; text-decoration: none;
  }
  .btn:hover { background: var(--bg-primary); color: var(--text-primary); }
  a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .btn, .btn:hover { text-decoration: none; }
  section { border-top: 1px solid var(--border); margin-top: 40px; padding-top: 24px; }
  section > * + * { margin-top: 12px; }
  h2 { font-size: 20px; font-weight: 700; line-height: 1.3; }
  .note { font-size: 14px; color: var(--text-secondary); line-height: 1.5; }
  .hero-side > .note { font-size: 15px; }
  pre { padding: 12px 14px; border: 1px solid var(--border); overflow-x: auto; font: 14px/1.5 'JetBrains Mono', monospace; }
  .account { margin-top: 28px; font-size: 16px; }
  .foot { padding-top: 40px; padding-bottom: 40px; font-size: 13px; color: var(--text-secondary); text-align: left; }

  @media (min-width: 960px) {
    .page, .foot { max-width: 68rem; padding: 0 48px; }
    .page { padding-top: 40px; }
    .foot { padding-top: 40px; padding-bottom: 40px; }
    .hero { display: grid; grid-template-columns: 1fr 26rem; column-gap: 64px; align-items: start; }
    .who { grid-column: 1 / -1; }
    h1 { grid-column: 1; grid-row: 2; font-size: 44px; margin: 20px 0 0; }
    .hero-plan { grid-column: 2; grid-row: 2 / 4; margin-top: 24px; }
    .hero-side { grid-column: 1; grid-row: 3; margin-top: 16px; }
    section, .account { max-width: 40rem; }
  }
</style>
