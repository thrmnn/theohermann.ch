---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { author } from '../data/author';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const mailto = `mailto:${author.email}`;
const REPO = 'https://github.com/thrmnn/ros2-localization-triage';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stataMeta = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-replay.meta.json'), 'utf8'),
) as {
  platform: string;
  dataset: string;
  duration_s: number;
  events: number;
  events_by_detector: { tf_jump: number; covariance_spike: number; pose_divergence: number };
  lost_window: {
    window: string;
    position_error_median_m: number;
    amcl_reported_sigma_median_m: number;
    events: number;
  };
  zones_s: { healthy_end_s: number; lost_start_s: number; lost_end_s: number };
};
const { tf_jump, covariance_spike, pose_divergence } = stataMeta.events_by_detector;
if (tf_jump + covariance_spike + pose_divergence !== stataMeta.events) {
  throw new Error(
    `stata-replay.meta.json: events_by_detector (${tf_jump}+${covariance_spike}+${pose_divergence}) does not sum to events (${stataMeta.events})`,
  );
}
const lostMetres = stataMeta.lost_window.position_error_median_m.toFixed(1);
const lostCm = Math.round(stataMeta.lost_window.amcl_reported_sigma_median_m * 100);
const lostEvents = stataMeta.lost_window.events;
const artifactCaption = `${stataMeta.platform} · ${stataMeta.duration_s} s of a recorded run · ${stataMeta.events} detector events`;

const stataReplay = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-replay.json'), 'utf8'),
) as { events: number[][] };

const durationS = stataMeta.duration_s;
const { healthy_end_s, lost_start_s, lost_end_s } = stataMeta.zones_s;
const pct = (s: number) => Number(((s / durationS) * 100).toFixed(3));
const healthyWidth = pct(healthy_end_s);
const excursionLeft = pct(healthy_end_s);
const excursionWidth = pct(lost_start_s) - pct(healthy_end_s);
const lostLeft = pct(lost_start_s);
const lostWidth = pct(lost_end_s) - pct(lost_start_s);
const excursionMid = excursionLeft + excursionWidth / 2;
const lostMid = lostLeft + lostWidth / 2;
const eventTicks = stataReplay.events.map(([t]) => pct(t / 10));
const timelineAriaLabel = `Timeline of the ${durationS} second replay: healthy until ${healthy_end_s} seconds, an excursion to a floor with no ground truth until ${lost_start_s} seconds, then lost and ${lostMetres} metres off until ${lost_end_s} seconds.`;
---

<BaseLayout ogType="profile">
  <section id="home" class="hero-section">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <div class="hero-type">
        <p class="eyebrow" data-reveal style="--reveal-d: 0;">
          Théo Alessandro Hermann, independent practitioner
        </p>
        <h1 class="hero-name" data-reveal style="--reveal-d: 1;">I read robot navigation logs.</h1>
        <p class="hero-positioning" data-reveal style="--reveal-d: 2;">
          I froze four fault detectors before I looked at any results, ran them unchanged on 108 minutes of recordings from five platforms, and published what they caught, what they missed, and the raw counts behind both.
        </p>
      </div>
    </div>
  </section>

  <section class="artifact-band">
    <div class="artifact-band-grid">
      <div class="hero-artifact" data-reveal style="--reveal-d: 1;">
        <div class="artifact-frame">
          <canvas
            class="favela-scrubber"
            data-walls={`${base}/data/stata-walls.bin`}
            data-replay={`${base}/data/stata-replay.json`}
            aria-label="Replay of a recorded PR2 run in the MIT Stata Center: wall map, the robot's estimated path, and the moments a fault detector fired."
          ></canvas>
          <div class="artifact-corners" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
        </div>
        <p class="artifact-caption">{artifactCaption}</p>
        <p class="artifact-provenance">
          recorded data: MIT Stata Center dataset (CC BY 3.0) · detections: <a href={REPO}>ros2-localization-triage</a> · open source, every number recomputable
        </p>
      </div>
      <div class="artifact-explain" data-reveal style="--reveal-d: 2;">
        <p class="section-label artifact-explain-eyebrow">One recorded run, replayed</p>
        <h2 class="artifact-explain-heading">A robot that was lost and did not know it.</h2>
        <ol class="result-list">
          <li class="result-item">
            <span class="result-num">01</span>
            <div class="result-body">
              <p>
                A real robot in a real building, replayed from its own log: the file where it writes down, many times a second, where it thinks it is. Grey: the walls. Green: where it believed it was.
              </p>
            </div>
          </li>
          <li class="result-item">
            <span class="result-num">02</span>
            <div class="result-body">
              <p>
                It rode the lift to a floor its map did not have, and came back. From then on it was {lostMetres} metres from where it thought it was, while reporting {lostCm} centimetres of doubt. The robot itself never noticed.
              </p>
            </div>
          </li>
          <li class="result-item">
            <span class="result-num">03</span>
            <div class="result-body">
              <p>
                Amber: where my detectors noticed. {lostEvents} flags in the stretch where the truth is known. They caught the transition, then went silent once the wrong pose settled. Finding that quiet kind of failure is the work.
              </p>
            </div>
          </li>
        </ol>
        <div class="artifact-timeline" role="img" aria-label={timelineAriaLabel}>
          <span class="timeline-zone timeline-zone-healthy" style={`left: 0%; width: ${healthyWidth}%;`}></span>
          <span class="timeline-zone timeline-zone-excursion" style={`left: ${excursionLeft}%; width: ${excursionWidth}%;`}></span>
          <span class="timeline-zone timeline-zone-lost" style={`left: ${lostLeft}%; width: ${lostWidth}%;`}></span>
          {eventTicks.map((left) => (
            <span class="timeline-tick" style={`left: ${left}%;`}></span>
          ))}
        </div>
        <div class="timeline-labels">
          <span class="artifact-caption timeline-label timeline-label-start">0 s</span>
          <span class="artifact-caption timeline-label timeline-label-mid" style={`left: ${excursionMid}%;`}>another floor, no ground truth</span>
          <span class="artifact-caption timeline-label timeline-label-mid" style={`left: ${lostMid}%;`}>back, {lostMetres} m off</span>
          <span class="artifact-caption timeline-label timeline-label-end">{durationS} s</span>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>The problem</h2>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 1;">
        A fleet's worst localisation incidents are the quiet ones: the robot that was somewhere else while reporting centimetre confidence, the alarm that fired on a healthy machine, the failure nobody can reproduce from the bag, which is the robot's own recording. Nav2, the ROS 2 navigation stack, ships its localiser AMCL with kidnap recovery switched off, so a displaced robot has no mechanism to conclude it is lost. Someone has to notice, and the bag is usually all they have.
      </p>
    </div>
  </section>

  <section class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>Three results</h2>
      <ol class="result-list">
        <li class="result-item" data-reveal style="--reveal-d: 1;">
          <span class="result-num">01</span>
          <div class="result-body">
            <p>
              The same frozen thresholds did not transfer. The covariance threshold, set on a simulated TurtleBot3, sits inside a real Tiago's healthy yaw noise and fired five times on a recording with nothing wrong, graded wrong in the case log. A threshold is a property of the machine it was measured on.
            </p>
            <span class="result-provenance">Source <a href={`${REPO}/blob/main/docs/transferability.md`}>docs/transferability.md</a></span>
          </div>
        </li>
        <li class="result-item" data-reveal style="--reveal-d: 2;">
          <span class="result-num">02</span>
          <div class="result-body">
            <p>
              Against labels somebody else wrote, years before this tool existed: 16 of 16 gaps found, nothing else flagged. The labels give how many gaps each recording has, not when, so the match is a match of counts, one for one.
            </p>
            <figure class="result-figure">
              <img
                src={`${base}/figures/labelled-recall.webp`}
                alt="Sixteen labelled laser gaps in two Cartographer recordings, two and fourteen, each matched by a detection; count match, not time match."
                width="1140"
                height="660"
                loading="lazy"
              />
              <figcaption>
                Two Cartographer backpack recordings on a shared timeline: the dataset's Known Issues column counts 2 and 14 laser gaps, and the frozen detector found 2 and 14 events, nothing elsewhere.
              </figcaption>
            </figure>
            <span class="result-provenance">
              Source <a href={`${REPO}/tree/main/results/labelled`}>results/labelled/</a> · <a href={`${REPO}/blob/main/docs/figures/labelled-recall.png`}>docs/figures/labelled-recall.png</a>
            </span>
          </div>
        </li>
        <li class="result-item" data-reveal style="--reveal-d: 3;">
          <span class="result-num">03</span>
          <div class="result-body">
            <p>
              A localiser 19.4 metres wrong reported 8 centimetres of uncertainty. The detectors caught the transition, then went silent once the wrong pose settled. No monitor built on the robot's own estimates can see steady-state confident wrongness.
            </p>
            <span class="result-provenance">Source <a href={`${REPO}/blob/main/docs/finding-confidently-wrong.md`}>docs/finding-confidently-wrong.md</a></span>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>What this means for a fleet</h2>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 1;">
        Monitoring rules tuned on one robot mean something different on the next one, and a localiser that has settled into a wrong pose looks healthy to any check that trusts its own estimate. Triage on a fleet is therefore a calibration-and-ground-truth problem before it is a tooling problem.
      </p>
    </div>
  </section>

  <section class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>What this does not claim</h2>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 1;">
        These are localisation-layer detectors, not an intrusion detection system and not a product. I recorded, ran and self-graded everything, under a rubric committed before any real result existed; the case log carries two verdicts of wrong and three of partial across fifteen graded rows. Nothing in the stock config is calibrated for your robot.
      </p>
    </div>
  </section>

  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="contact-bg absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>The ask</h2>
      <p class="ask-line" data-reveal style="--reveal-d: 1;">
        If a robot in your fleet was somewhere it should not have been, and the bag exists, twenty minutes over that bag is the conversation I am proposing.
      </p>
      <p class="ask-line" data-reveal style="--reveal-d: 2;">
        Analysis runs on your infrastructure or under NDA on mine; nothing is retained after handover.
      </p>
      <ul class="engagement-list" data-reveal style="--reveal-d: 3;">
        <li class="engagement-item"><span class="engagement-label">Twenty minutes, free:</span> you bring the incident, I say whether I can help.</li>
        <li class="engagement-item"><span class="engagement-label">Written proposal:</span> fixed scope, fixed price, before you commit.</li>
        <li class="engagement-item"><span class="engagement-label">Weekly written updates:</span> what shipped, what is next, what is at risk.</li>
        <li class="engagement-item"><span class="engagement-label">Handover:</span> running code, documentation and a written report.</li>
      </ul>
      <div class="ask-cta-row" data-reveal style="--reveal-d: 4;">
        <Button href={author.cal} external>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Book a 20-minute call
        </Button>
        <Button href={mailto} variant="secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </Button>
      </div>
      <p class="contact-mail-line" data-reveal style="--reveal-d: 5;">
        <a href={mailto}>{author.email}</a>
        <span class="footer-sep">·</span>
        <span>Background and other work: <a href="https://theoalessandro.com">theoalessandro.com</a></span>
      </p>
    </div>
  </section>

  <footer class="site-footer">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6 py-8">
      <div class="footer-line">
        <a href={author.github}>github.com/thrmnn</a>
        <span class="footer-sep">·</span>
        <span>recorded data: MIT Stata Center dataset (CC BY 3.0) · detections: <a href={REPO}>ros2-localization-triage</a></span>
        <span class="footer-sep">·</span>
        <ThemeToggle />
      </div>
    </div>
  </footer>

  <script>
    import { initFavelaScrubber } from '../scripts/favela-scrubber.ts';
    const canvas = document.querySelector('.favela-scrubber') as HTMLCanvasElement | null;
    if (canvas) initFavelaScrubber(canvas);
  </script>
</BaseLayout>
