---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { author } from '../data/author';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// Numbers that are static README-verbatim text (not in the meta sidecar), with
// their source in the demo at github.com/thrmnn/ros2-localization-triage:
//   recovery_alpha 0.0, the two ros2 param lines  docs/finding-amcl-recovery.md
//   37 detections, 27 s stall, 22.7 s hole, 340x   docs/finding-recorder-artifacts.md
//   108 minutes, five platforms, two wrong, three partial, fifteen rows  README.md
//   Thresholds do not travel between robots         README.md, docs/transferability.md
const mailto = `mailto:${author.email}`;
const REPO = 'https://github.com/thrmnn/ros2-localization-triage';

const stataMeta = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-replay.meta.json'), 'utf8'),
) as {
  platform: string;
  dataset: string;
  duration_s: number;
  events: number;
  events_by_detector: { tf_jump: number; covariance_spike: number; pose_divergence: number };
  lost_window: {
    window: string;
    position_error_median_m: number;
    amcl_reported_sigma_median_m: number;
    events: number;
  };
  excursion: { events: number };
  zones_s: { healthy_end_s: number; lost_start_s: number; lost_end_s: number };
};
const { tf_jump, covariance_spike, pose_divergence } = stataMeta.events_by_detector;
if (tf_jump + covariance_spike + pose_divergence !== stataMeta.events) {
  throw new Error(
    `stata-replay.meta.json: events_by_detector (${tf_jump}+${covariance_spike}+${pose_divergence}) does not sum to events (${stataMeta.events})`,
  );
}
const lostMetres = stataMeta.lost_window.position_error_median_m.toFixed(1);
const lostCm = Math.round(stataMeta.lost_window.amcl_reported_sigma_median_m * 100);
const lostEvents = stataMeta.lost_window.events;
const artifactCaption = `${stataMeta.duration_s} s of localiser output · ${stataMeta.events} detector events`;
const artifactProvenance = `${stataMeta.platform}, MIT Stata Center dataset (CC BY 3.0)`;

const stataReplay = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-replay.json'), 'utf8'),
) as { events: number[][] };

const durationS = stataMeta.duration_s;
const { healthy_end_s, lost_start_s, lost_end_s } = stataMeta.zones_s;
const pct = (s: number) => Number(((s / durationS) * 100).toFixed(3));
const healthyWidth = pct(healthy_end_s);
const excursionLeft = pct(healthy_end_s);
const excursionWidth = pct(lost_start_s) - pct(healthy_end_s);
const lostLeft = pct(lost_start_s);
const lostWidth = pct(lost_end_s) - pct(lost_start_s);
const eventTicks = stataReplay.events.map(([t]) => pct(t / 10));
const timelineAriaLabel = `Timeline of the ${durationS} second replay, in four zones: healthy, on floor 2, until ${healthy_end_s} seconds; on the floor with no map until ${lost_start_s} seconds; back, but ${lostMetres} metres off, until ${lost_end_s} seconds; then unchanged until ${durationS} seconds.`;
---

<BaseLayout ogType="profile">
  <section class="pt-[calc(var(--space-section)/2)] pb-[calc(var(--space-section)/3)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <p class="eyebrow" data-reveal>Théo Hermann, independent practitioner</p>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 1;">
        MSc Robotics, EPFL. Perception and autonomy work at EPFL VITA Lab, IRI Barcelona and Roboat, 2022 to 2024.
      </p>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 2;">
        I read robot navigation logs. When a robot in your fleet misbehaves in the field and the recording is all you have, I reconstruct what happened from it, say what the evidence supports and what it does not, and hand it back in writing.
      </p>
    </div>
  </section>

  <section id="home" class="hero-section">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <div class="hero-type">
        <p class="eyebrow" data-reveal>One public recording, written up the way you would get yours.</p>
        <h1 class="hero-name" data-reveal style="--reveal-d: 0;">A robot that was lost and did not know it.</h1>
      </div>
    </div>
  </section>

  <section class="artifact-band">
    <div class="artifact-band-grid">
      <div class="hero-artifact" data-reveal style="--reveal-d: 1;">
        <div class="timeline-ends" aria-hidden="true">
          <span class="artifact-caption">0 s</span>
          <span class="artifact-caption">{durationS} s</span>
        </div>
        <div class="artifact-timeline" role="img" aria-label={timelineAriaLabel}>
          <span class="timeline-zone timeline-zone-healthy" style={`left: 0%; width: ${healthyWidth}%;`}></span>
          <span class="timeline-zone timeline-zone-excursion" style={`left: ${excursionLeft}%; width: ${excursionWidth}%;`}></span>
          <span class="timeline-zone timeline-zone-lost" style={`left: ${lostLeft}%; width: ${lostWidth}%;`}></span>
          {eventTicks.map((left) => (
            <span class="timeline-tick" style={`left: ${left}%;`}></span>
          ))}
        </div>
        <div class="timeline-labels">
          <span class="artifact-caption timeline-label timeline-label-zone timeline-label-healthy" style="left: 0%;">healthy, on floor 2</span>
          <span class="artifact-caption timeline-label timeline-label-zone timeline-label-excursion" style={`left: ${excursionLeft}%;`}>on the floor with no map</span>
          <span class="artifact-caption timeline-label timeline-label-zone timeline-label-lost">back, but {lostMetres} m off</span>
        </div>
        <p class="artifact-caption">{artifactCaption}</p>
      </div>
      <div class="artifact-explain sample-report" data-reveal style="--reveal-d: 2;">
        <dl class="sample-fields">
          <div>
            <dt>What happened</dt>
            <dd>Two minutes of centimetre tracking on floor 2; then an elevator to a floor its map does not contain, and back. From there the localiser's belief sat {lostMetres} metres from where the robot stood, reporting {lostCm} centimetres of uncertainty.</dd>
          </div>
          <div>
            <dt>What the evidence supports</dt>
            <dd>The ground truth is the dataset's own ceiling AprilTags, not any localiser. In the window they prove the belief {lostMetres} metres off, three checks fired {lostEvents} times.</dd>
          </div>
          <div>
            <dt>What it does not support</dt>
            <dd>Once the wrong pose settled, the checks went quiet, and so did the robot's own confidence number. Nothing built on the robot's own estimates can see that state; an external reference can.</dd>
          </div>
        </dl>
        <span class="result-provenance">Source <a href={`${REPO}/blob/main/docs/finding-confidently-wrong.md`}>docs/finding-confidently-wrong.md</a> · {artifactProvenance}</span>
      </div>
    </div>
  </section>

  <section class="pb-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>Two more findings</h2>
      <ul class="finding-list">
        <li class="finding-item" data-reveal style="--reveal-d: 1;">
          <p>Stock Nav2 ships AMCL with kidnap recovery switched off: both recovery_alpha terms default to 0.0, so a displaced robot has no mechanism to conclude it is lost. Check yours:</p>
          <pre class="cmd"><code>ros2 param get /amcl recovery_alpha_slow
ros2 param get /amcl recovery_alpha_fast</code></pre>
          <span class="result-provenance">Source <a href={`${REPO}/blob/main/docs/finding-amcl-recovery.md`}>docs/finding-amcl-recovery.md</a></span>
        </li>
        <li class="finding-item" data-reveal style="--reveal-d: 2;">
          <p>37 gap detections on a healthy laser, in a recording from a Tiago-family robot: the bag writer had stalled for 27 seconds; the sensor never missed a beat. On its own stamps, zero; on the same robot's run under attack, a genuine 22.7-second hole at 340 times the median interval.</p>
          <span class="result-provenance">Source <a href={`${REPO}/blob/main/docs/finding-recorder-artifacts.md`}>docs/finding-recorder-artifacts.md</a></span>
        </li>
      </ul>
    </div>
  </section>

  <section id="triage" class="pb-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>What I take on</h2>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 1;">
        Offline analysis of what your robots recorded. Nothing goes on the robot.
      </p>
      <ul class="engagement-list" data-reveal style="--reveal-d: 2;">
        <li class="engagement-item"><span class="engagement-label">One incident.</span> You bring the bag; I write it back in the shape above.</li>
        <li class="engagement-item"><span class="engagement-label">Your fleet.</span> Thresholds do not travel between robots, so I set them on your recordings, measure how often each fires when nothing is wrong, and hand over the scripts.</li>
      </ul>
      <p class="max-w-prose text-text-secondary leading-relaxed mt-6" data-reveal style="--reveal-d: 3;">
        Analysis runs on your infrastructure or under NDA on mine; nothing is retained after handover.
      </p>
    </div>
  </section>

  <section class="pb-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>The record</h2>
      <p class="max-w-prose text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 1;">
        Not a product: four detectors, frozen before any result, run unchanged on 108 minutes of recordings from five platforms, self-graded under a rubric committed first; two verdicts of wrong and three of partial across fifteen graded rows. Every number recomputes: <a href={REPO}>github.com/thrmnn/ros2-localization-triage</a>
      </p>
    </div>
  </section>

  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="contact-bg absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-6" data-reveal>The ask</h2>
      <p class="ask-line" data-reveal style="--reveal-d: 1;">
        If a robot in your fleet was somewhere it should not have been, and the bag exists, twenty minutes over that bag is the conversation I am proposing.
      </p>
      <p class="ask-line" data-reveal style="--reveal-d: 2;">
        Analysis runs on your infrastructure or under NDA on mine; nothing is retained after handover.
      </p>
      <ul class="engagement-list" data-reveal style="--reveal-d: 3;">
        <li class="engagement-item"><span class="engagement-label">Twenty minutes, free:</span> you bring the incident, I say whether I can help.</li>
        <li class="engagement-item"><span class="engagement-label">Written proposal:</span> fixed scope, fixed price, before you commit.</li>
        <li class="engagement-item"><span class="engagement-label">Weekly written updates:</span> what shipped, what is next, what is at risk.</li>
        <li class="engagement-item"><span class="engagement-label">Handover:</span> running code, documentation and a written report.</li>
      </ul>
      <div class="ask-cta-row" data-reveal style="--reveal-d: 4;">
        <Button href={author.cal} external>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Book a 20-minute call
        </Button>
        <Button href={mailto} variant="secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </Button>
      </div>
      <p class="contact-mail-line" data-reveal style="--reveal-d: 5;">
        <a href={mailto}>{author.email}</a>
      </p>
    </div>
  </section>

  <footer class="site-footer">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6 py-8">
      <div class="footer-line">
        <a href={author.github}>github.com/thrmnn</a>
        <span class="footer-sep">·</span>
        <span>recorded data: MIT Stata Center dataset (CC BY 3.0), Universidad de León clean-and-attack recordings (CC BY 4.0) · detections: <a href={REPO}>ros2-localization-triage</a></span>
        <span class="footer-sep">·</span>
        <span>open source, every number on this page recomputes</span>
        <span class="footer-sep">·</span>
        <ThemeToggle />
      </div>
    </div>
  </footer>

</BaseLayout>
