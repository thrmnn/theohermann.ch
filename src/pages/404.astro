---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <section class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6 text-center">
      <h1 class="hero-name">Page not found.</h1>
      <p class="mt-4">
        <a href="/" class="text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">Back to the homepage</a>
      </p>
    </div>
  </section>
</BaseLayout>
