---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const { zones_s, poses } = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-series.json'), 'utf8'),
) as { zones_s: { healthy_end_s: number; lost_start_s: number; lost_end_s: number }; poses: number[][] };

const W = 460, H = 300, L = 60, R = 150, T = 14, B = 40;
const tMax = 400;
const yMin = 0.01, yMax = 100;
const x = (t: number) => L + (t / tMax) * (W - L - R);
const y = (m: number) => {
  const v = Math.min(Math.max(m, yMin), yMax);
  return T + ((Math.log10(yMax) - Math.log10(v)) / (Math.log10(yMax) - Math.log10(yMin))) * (H - T - B);
};

const median = (a: number[]) => {
  const s = [...a].sort((p, q) => p - q);
  return s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2;
};
const lost = poses.filter((p) => p[0] >= zones_s.lost_start_s);
const errMed = median(lost.map((p) => p[1]));
const sigMed = median(lost.map((p) => p[2]));

const ticks: [number, string][] = [[0.01, '1 cm'], [0.1, '10 cm'], [1, '1 m'], [10, '10 m'], [100, '100 m']];
const xEnd = x(zones_s.lost_end_s);
const label = `Position error against markers on the ceiling, and the robot's reported uncertainty, over ${tMax} seconds. On floor 2 both stay under half a metre. After an elevator ride to a floor its map does not contain and back, the error sits near ${errMed.toFixed(1)} metres while the reported uncertainty stays near ${Math.round(sigMed * 100)} centimetres.`;
---

<figure class="chart">
  <p class="reading"><strong>Black:</strong> how far its reported position was from the ceiling markers. <strong>Grey:</strong> how sure the robot said it was. After the elevator, black jumps to metres; grey stays at centimetres.</p>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    <rect class="gap" x={x(zones_s.healthy_end_s)} y={T} width={x(zones_s.lost_start_s) - x(zones_s.healthy_end_s)} height={H - T - B} />
    {['elevator to', 'a floor not', 'in its map:', 'no markers'].map((line, i) => (
      <text class="gap-label" x={(x(zones_s.healthy_end_s) + x(zones_s.lost_start_s)) / 2} y={T + 20 * (i + 1)} text-anchor="middle">{line}</text>
    ))}
    {ticks.map(([v, t]) => (
      <g>
        <line class="grid" x1={L} x2={W - R} y1={y(v)} y2={y(v)} />
        <text class="tick" x={L - 6} y={y(v) + 4} text-anchor="end">{t}</text>
      </g>
    ))}
    {[0, 100, 200, 300, 400].map((t) => (
      <text class="tick" x={x(t)} y={H - B + 24} text-anchor="middle">{t} s</text>
    ))}
    {poses.map((p) => <circle class="sig" cx={x(p[0]).toFixed(1)} cy={y(p[2]).toFixed(1)} r="2" />)}
    {poses.map((p) => <circle class="err" cx={x(p[0]).toFixed(1)} cy={y(p[1]).toFixed(1)} r="2" />)}
    <text class="lab lab-err" x={xEnd + 10} y={y(errMed) - 4}>how far off,</text>
    <text class="lab lab-err val" x={xEnd + 10} y={y(errMed) + 12}>median {errMed.toFixed(1)} m</text>
    <text class="lab" x={xEnd + 10} y={y(sigMed) - 4}>what it reported,</text>
    <text class="lab val" x={xEnd + 10} y={y(sigMed) + 12}>median {Math.round(sigMed * 100)} cm</text>
  </svg>
  <figcaption>One dot per position estimate; distances on a log scale. The ceiling markers are the dataset's AprilTags, independent of the robot's own estimate.</figcaption>
</figure>

<style>
  .chart { margin: 0; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .gap { fill: var(--bg-accent); }
  .gap-label { fill: var(--text-muted); font: 16px 'JetBrains Mono', monospace; }
  .grid { stroke: var(--border); stroke-width: 1; }
  .tick { fill: var(--text-muted); font: 16px 'JetBrains Mono', monospace; }
  .err { fill: var(--text-primary); }
  .sig { fill: var(--text-muted); opacity: 0.55; }
  .lab { fill: var(--text-secondary); font: 17px 'Space Grotesk', sans-serif; }
  .lab-err { fill: var(--text-primary); }
  .val { font-weight: 700; }
  @media (min-width: 960px) {
    .tick, .gap-label { font-size: 11px; }
    .lab { font-size: 12px; }
  }
  .reading { font-size: 16px; line-height: 1.5; margin-bottom: 12px; }
  figcaption { margin-top: 10px; font-size: 14px; line-height: 1.5; color: var(--text-secondary); }
</style>
